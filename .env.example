# MarketPulse environment template.
# Copy to .env and adjust. Never commit real credentials.

# --- Database ---------------------------------------------------------------
POSTGRES_USER=marketpulse
POSTGRES_PASSWORD=change-me
POSTGRES_DB=marketpulse
POSTGRES_PORT=5433

# Used when running the backend outside Docker (host access to the db service).
DATABASE_URL=postgresql://marketpulse:change-me@localhost:5433/marketpulse

# --- Backend ----------------------------------------------------------------
PORT=4000
BACKEND_PORT=4000
FRONTEND_PORT=5000
CORS_ORIGIN=*

# 'demo' simulates the market (default, clearly labelled in the UI).
# 'replay' streams stored historical bars through the same pipeline (no token needed).
# 'live' connects to the Upstox Market Data Feed V3 and requires UPSTOX_ACCESS_TOKEN.
MARKET_DATA_MODE=demo

# --- Historical replay (MARKET_DATA_MODE=replay) -----------------------------
# Provenance of the dataset that is replayed. Replay writes its own bars under
# 'replay', so the source dataset is never modified.
REPLAY_DATASET_SOURCE=demo
# Session loaded at start-up (YYYY-MM-DD, IST). Empty = most recent available.
REPLAY_SESSION=
# Initial playback speed; must be one of 1, 2, 5, 10.
REPLAY_SPEED=1
# Upper bound on events loaded for one session.
REPLAY_MAX_EVENTS=200000

# --- Provider credentials ---------------------------------------------------
# Backend-only. Never expose this to the frontend or commit it.
# Upstox tokens expire (typically daily); update this and restart the backend.
UPSTOX_ACCESS_TOKEN=
# Optional: path to the provider's official MarketDataFeedV3.proto
# UPSTOX_PROTO_PATH=/path/to/MarketDataFeedV3.proto
# UPSTOX_INSTRUMENTS_URL=https://assets.upstox.com/market-quote/instruments/exchange/NSE.json.gz

# --- Live feed behaviour ----------------------------------------------------
# Dashboard snapshot reconciliation interval (ms). Served from the backend cache.
LIVE_SNAPSHOT_REFRESH_MS=5000
# A quote is FRESH while its last accepted tick is younger than this (ms).
LIVE_STALE_THRESHOLD_MS=15000
# 'full' carries LTP, previous close, OHLC and volume; 'ltpc' is lighter.
UPSTOX_SUBSCRIPTION_MODE=full
# Instruments per subscription frame (provider maximum is 500).
UPSTOX_SUBSCRIPTION_BATCH_SIZE=100

# --- Tuning (optional) ------------------------------------------------------
# Demo feed cadence in milliseconds.
DEMO_TICK_INTERVAL_MS=1500
# How many days of demo daily history to seed on first boot.
SEED_HISTORY_DAYS=260
# Tick persistence sampling and retention.
TICK_SAMPLE_INTERVAL_MS=15000
TICK_RETENTION_HOURS=48
# Detection thresholds.
VOLUME_SPIKE_RATIO=2
PRICE_MOVE_PCT=2
PRICE_MOVE_WINDOW_MINUTES=15
VOLATILITY_SPIKE_MULTIPLE=2
EVENT_COOLDOWN_MINUTES=10
# Heatmap colour scale.
HEATMAP_NEUTRAL_BAND_PCT=0.05
HEATMAP_MAX_PCT=5
